# ============================================================
# Enterprise AI Research Engine — Configuration
# ============================================================

# Environnement : development | production
APP_ENV=development

# Clé API pour sécuriser l'accès (optionnel en dev)
API_KEY=

# ------------------------------------------------------------
# LLM (Ollama local — recommandé pour 8 Go RAM)
# ------------------------------------------------------------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Recommandé (8 Go RAM) : llama3.1:8b | Plus léger : llama3.2:3b | Plus puissant : mistral:7b
OLLAMA_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text
LLM_TIMEOUT=300

# Tokens générés par appel (augmenter pour des rapports plus longs)
OLLAMA_NUM_PREDICT_CHAT=280
OLLAMA_NUM_PREDICT_AGENT=400
OLLAMA_NUM_PREDICT_JSON=500
OLLAMA_NUM_CTX_AGENT=4096
OLLAMA_KEEP_ALIVE=30m
# Threads CPU pour Ollama (0 = auto, recommandé)
OLLAMA_NUM_THREAD=0

# Alternative Groq (gratuit, rapide) : https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------
# Optimisations 8 Go RAM
# ------------------------------------------------------------
# FAST_MODE=true désactive Playwright et réduit les workers
FAST_MODE=false
# Pages crawlées par site (réduit à 2 automatiquement en FAST_MODE)
MAX_PAGES_PAR_SITE=4
# Nombre de workers parallèles pour la recherche
SEARCH_PARALLEL_WORKERS=2
# Contextes browser simultanés (1-2 sur 8 Go RAM)
BROWSER_MAX_CONTEXTS=2

# ------------------------------------------------------------
# Moteurs de recherche — Providers
# ------------------------------------------------------------

# TAVILY (recommandé, 1000 req/mois gratuit) : https://tavily.com
TAVILY_API_KEY=
TAVILY_MONTHLY_LIMIT=950

# GOOGLE Custom Search (optionnel) : https://programmablesearchengine.google.com/
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# BRAVE Search (optionnel) : https://api.search.brave.com/
BRAVE_API_KEY=

# BING Web Search (optionnel) : https://azure.microsoft.com/cognitive-services/
BING_API_KEY=

# SERPER.dev (Google Search, 1000 req/mois gratuit) : https://serper.dev
SERPER_API_KEY=

# SerpAPI (optionnel) : https://serpapi.com
SERPAPI_KEY=

# DuckDuckGo (toujours actif, gratuit, sans clé)
ENABLE_DUCKDUCKGO=true

# ------------------------------------------------------------
# Scraping & Playwright
# ------------------------------------------------------------
USE_PLAYWRIGHT=true
REQUEST_TIMEOUT=15
MAX_RETRIES=3
SCRAPE_DELAY_SECONDS=1.0
EMBEDDING_VALIDATION_THRESHOLD=0.30

# ------------------------------------------------------------
# Agent — Paramètres de recherche
# ------------------------------------------------------------
MAX_SEARCH_ITERATIONS=3
MAX_RESULTS_PER_QUERY=8
MAX_VARIANTES_RECHERCHE=6
MAX_URLS_A_SCRAPER=15
MAX_BOUCLE_AGENT=12
COLLECTE_LARGE_URLS=40
COLLECTE_LARGE_VARIANTES=12
BENCHMARK_CIBLE_MIN_ENTITES=5
CHAT_RECHERCHE_LIVE=true

# Coverage & qualité
MIN_COVERAGE_SCORE=0.40
MIN_SOURCE_QUALITY=0.40
MAX_SEARCH_QUERIES=50

# Cache TTL (secondes)
PAGE_CACHE_TTL=86400
RESPONSE_CACHE_TTL=3600

# ------------------------------------------------------------
# Chemins de données
# ------------------------------------------------------------
OUTPUT_DIR=data/processed
RAW_DIR=data/raw
LOG_DIR=logs
MEMOIRE_DB=data/memoire.sqlite3
JOBS_DB=data/jobs.sqlite3

# ------------------------------------------------------------
# CORS (production uniquement)
# ------------------------------------------------------------
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000
