# Environnement : development | production
APP_ENV=development

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Recommandé (8+ Go RAM) : llama3.1:8b | Minimum (4-8 Go RAM) : llama3.2:3b
OLLAMA_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text
LLM_TIMEOUT=300

# Optimisations CPU — activer FAST_MODE=true sur machine lente (8 Go RAM, sans GPU)
FAST_MODE=false
OLLAMA_NUM_PREDICT_CHAT=280
OLLAMA_NUM_PREDICT_AGENT=350
SEARCH_PARALLEL_WORKERS=4
# Nombre de threads CPU pour Ollama (0 = auto-détect, recommandé)
# Si Ollama est lent, essaie OLLAMA_NUM_THREAD=8 (ou le nb de cœurs physiques)
OLLAMA_NUM_THREAD=0
# Nombre de pages internes crawlées par site (réduit à 2 en FAST_MODE automatiquement)
MAX_PAGES_PAR_SITE=4

# Recommandé : clé gratuite sur https://tavily.com (1000 requêtes/mois)
TAVILY_API_KEY=

# Optionnel : https://programmablesearchengine.google.com/
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Repli gratuit sans clé (DuckDuckGo + Google News + sites sectoriels)
ENABLE_DUCKDUCKGO=true

# CORS — en production, liste explicite des origines autorisées
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000

REQUEST_TIMEOUT=15
MAX_RETRIES=3
SCRAPE_DELAY_SECONDS=1.5
USE_PLAYWRIGHT=true

MAX_SEARCH_ITERATIONS=3
MAX_RESULTS_PER_QUERY=8
MAX_VARIANTES_RECHERCHE=6
MAX_URLS_A_SCRAPER=15
MAX_BOUCLE_AGENT=8
COLLECTE_LARGE_URLS=40
COLLECTE_LARGE_VARIANTES=12
CHAT_RECHERCHE_LIVE=true
